CONFIG_CMD_MOCHA_WINPROBE=y
CONFIG_BLKMAP=y
CONFIG_BOOTCOMMAND="winprobe"
# Tegra selects MMC, so omit its controller driver and command.
# CONFIG_MMC_SDHCI_TEGRA is not set
# CONFIG_CMD_MMC is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_CMD_EBTUPDATE is not set
