diff --git a/lib/Kconfig b/lib/Kconfig
--- a/lib/Kconfig
+++ b/lib/Kconfig
@@ -1233,6 +1233,13 @@
 	  a malloc() implementation for defining the data structures
 	  needed for maintaining the LMB memory map.
 
+config LMB_RESERVE_PRAM
+	bool "Reserve protected RAM in the system memory maps"
+	depends on LMB
+	help
+	  Keep the protected RAM selected by CFG_PRAM out of LMB
+	  allocations and mark it reserved in the EFI memory map.
+
 config SPL_LMB
 	bool "Enable LMB module for SPL"
 	depends on SPL && SPL_FRAMEWORK && SPL_SYS_MALLOC
diff --git a/include/asm-generic/global_data.h b/include/asm-generic/global_data.h
--- a/include/asm-generic/global_data.h
+++ b/include/asm-generic/global_data.h
@@ -75,6 +75,12 @@
 	 * @ram_top: top address of RAM used by U-Boot
 	 */
 	phys_addr_t ram_top;
+#if CONFIG_IS_ENABLED(LMB_RESERVE_PRAM)
+	/**
+	 * @pram_size: protected RAM size selected before relocation, in bytes
+	 */
+	phys_size_t pram_size;
+#endif
 	/**
 	 * @flags: global data flags
 	 *
diff --git a/common/board_f.c b/common/board_f.c
--- a/common/board_f.c
+++ b/common/board_f.c
@@ -385,11 +385,14 @@
 /* reserve protected RAM */
 static int reserve_pram(void)
 {
-	ulong reg;
+	ulong kib = env_get_ulong("pram", 10, CFG_PRAM);
+	ulong size = kib << 10;
 
-	reg = env_get_ulong("pram", 10, CFG_PRAM);
-	gd->relocaddr -= (reg << 10);		/* size is in kB */
-	debug("Reserving %ldk for protected RAM at %08lx\n", reg,
+	gd->relocaddr -= size;
+#if CONFIG_IS_ENABLED(LMB_RESERVE_PRAM)
+	gd->pram_size = size;
+#endif
+	debug("Reserving %ldk for protected RAM at %08lx\n", kib,
 	      gd->relocaddr);
 	return 0;
 }
diff --git a/lib/lmb.c b/lib/lmb.c
--- a/lib/lmb.c
+++ b/lib/lmb.c
@@ -540,30 +540,31 @@
 	ulong pram = 0;
 
 	rsv_start = gd->start_addr_sp - CONFIG_STACK_SIZE;
-	end = gd->ram_top;
+	/* An exclusive RAM end of 4 GiB wraps to zero on ARM32. */
+	end = gd->ram_top - 1;
 
 	/*
 	 * Reserve memory from aligned address below the bottom of U-Boot stack
 	 * until end of RAM area to prevent LMB from overwriting that memory.
 	 */
 	debug("## Current stack ends at 0x%08lx ", (ulong)rsv_start);
 
-#ifdef CFG_PRAM
+#if defined(CFG_PRAM) && !CONFIG_IS_ENABLED(LMB_RESERVE_PRAM)
+	/* Some boards intentionally allow LMB callers to use PRAM. */
 	pram = env_get_ulong("pram", 10, CFG_PRAM);
 	pram = pram << 10; /* size is in kB */
 #endif
 
 	for (bank = 0; bank < CONFIG_NR_DRAM_BANKS; bank++) {
 		if (!gd->bd->bi_dram[bank].size ||
 		    rsv_start < gd->bd->bi_dram[bank].start)
 			continue;
 		/* Watch out for RAM at end of address space! */
 		bank_end = gd->bd->bi_dram[bank].start +
 			gd->bd->bi_dram[bank].size - 1;
+		bank_end = min(bank_end, end);
 		if (rsv_start > bank_end)
 			continue;
-		if (bank_end > end)
-			bank_end = end - 1;
 
 		lmb_reserve(rsv_start, bank_end - rsv_start - pram + 1,
 			    LMB_NOOVERWRITE);
diff --git a/lib/efi_loader/efi_memory.c b/lib/efi_loader/efi_memory.c
--- a/lib/efi_loader/efi_memory.c
+++ b/lib/efi_loader/efi_memory.c
@@ -915,6 +915,19 @@
 
 	add_u_boot_and_runtime();
 
+#if CONFIG_IS_ENABLED(LMB_RESERVE_PRAM)
+	if (gd->pram_size) {
+		phys_addr_t start = gd->ram_top - gd->pram_size;
+
+		/* Keep PRAM reserved after ExitBootServices(). */
+		if (efi_add_memory_map((uintptr_t)map_sysmem(start, 0),
+				       gd->pram_size, EFI_RESERVED_MEMORY_TYPE) !=
+		    EFI_SUCCESS) {
+			log_err("Cannot add protected RAM to the EFI memory map\n");
+			return -1;
+		}
+	}
+#endif
 #ifdef CONFIG_EFI_LOADER_BOUNCE_BUFFER
 	/* Request a 32bit 64MB bounce buffer region */
 	uint64_t efi_bounce_buffer_addr = 0xffffffff;
