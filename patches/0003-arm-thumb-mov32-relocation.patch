+#ifdef __arm__
+static u16 efi_thumb_mov_imm16(u16 first, u16 second)
+{
+	/* imm16 = imm4:i:imm3:imm8 */
+	return ((first & 0x000f) << 12) | ((first & 0x0400) << 1) |
+	       ((second & 0x7000) >> 4) | (second & 0x00ff);
+}
+
+static void efi_thumb_mov_set_imm16(u8 *insn, u16 first, u16 second, u16 imm)
+{
+	first = (first & ~0x040f) | (imm >> 12) | ((imm >> 1) & 0x0400);
+	second = (second & ~0x70ff) | ((imm << 4) & 0x7000) | (imm & 0x00ff);
+	put_unaligned_le16(first, insn);
+	put_unaligned_le16(second, insn + 2);
+}
+
+static bool efi_arm_relocate_mov32t(u8 *fixup, u32 delta)
+{
+	/* Thumb-2 stores the first halfword first, each in little-endian. */
+	u16 movw1 = get_unaligned_le16(fixup);
+	u16 movw2 = get_unaligned_le16(fixup + 2);
+	u16 movt1 = get_unaligned_le16(fixup + 4);
+	u16 movt2 = get_unaligned_le16(fixup + 6);
+	u16 rd = movw2 & 0x0f00;
+	u32 addr;
+
+	/* Validate MOVW then MOVT to the same register, with PC reserved. */
+	if ((movw1 & 0xfbf0) != 0xf240 || (movt1 & 0xfbf0) != 0xf2c0 ||
+	    ((movw2 | movt2) & 0x8000) || rd != (movt2 & 0x0f00) ||
+	    rd == 0x0f00)
+		return false;
+
+	addr = efi_thumb_mov_imm16(movw1, movw2) |
+	       ((u32)efi_thumb_mov_imm16(movt1, movt2) << 16);
+	addr += delta;
+	efi_thumb_mov_set_imm16(fixup, movw1, movw2, (u16)addr);
+	efi_thumb_mov_set_imm16(fixup + 4, movt1, movt2, addr >> 16);
+
+	return true;
+}
