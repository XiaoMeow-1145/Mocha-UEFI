+#ifdef MOCHA_WINPROBE_ARM32_TRACE
+static unsigned long winprobe_ebs_cpsr;
+static unsigned int winprobe_ebs_sctlr;
+
+static void winprobe_arm32_image_return(const char *path, efi_status_t status)
+{
+	unsigned long cpsr;
+
+	if (systab.boottime) {
+		printf("WINPROBE EFI image %s status=0x%08lx\n", path, status);
+		return;
+	}
+
+	/* Only attempt console output in the same physical execution state. */
+	cpsr = get_cpsr();
+	if ((cpsr & MODE_MASK) == SVC_MODE &&
+	    !((cpsr ^ winprobe_ebs_cpsr) & GENMASK(9, 0)) &&
+	    !(winprobe_ebs_sctlr & CR_M) && get_cr() == winprobe_ebs_sctlr &&
+	    gd && (gd->flags & GD_FLG_HAVE_CONSOLE))
+		printf("WINPROBE EFI image %s after EBS status=0x%08lx\n",
+		       path, status);
+
+	/* Boot-service memory and devices may now belong to the payload. */
+	for (;;)
+		;
+}
