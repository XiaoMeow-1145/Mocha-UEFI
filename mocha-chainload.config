# U-Boot v2025.10 doc/board/xiaomi/mocha.rst: chainload configuration.
CONFIG_TEXT_BASE=0x80A00000
CONFIG_SKIP_LOWLEVEL_INIT=y
# CONFIG_OF_BOARD_SETUP is not set
CONFIG_TEGRA_PRAM=y
CONFIG_LMB_RESERVE_PRAM=y
CONFIG_IDENT_STRING=" Mocha UEFI PoC"
# Prefer the first partition of the external microSD.
CONFIG_BOOTCOMMAND="if fatload mmc 1:1 ${kernel_addr_r} /EFI/BOOT/BOOTARM.EFI && echo UEFI: launching removable application && bootefi ${kernel_addr_r} ${fdtcontroladdr}; then echo UEFI: removable application returned; else echo UEFI: running built-in probe; bootefi hello ${fdtcontroladdr}; fi"
# Keep the test environment in RAM, independent of eMMC state.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_EFI_VARIABLE_FILE_STORE is not set
CONFIG_EFI_VARIABLE_NO_STORE=y
