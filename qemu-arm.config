# Mirror the Mocha path using the virt machine's VirtIO removable disk.
CONFIG_LMB_RESERVE_PRAM=y
CONFIG_CMD_VIRTIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_BOOTCOMMAND="if virtio scan && fatload virtio 0:1 ${kernel_addr_r} /EFI/BOOT/BOOTARM.EFI && echo UEFI: launching removable application && bootefi ${kernel_addr_r} ${fdtcontroladdr}; then echo UEFI: removable application returned; else echo UEFI: running built-in probe; bootefi hello ${fdtcontroladdr}; fi"
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FLASH is not set
# CONFIG_EFI_VARIABLE_FILE_STORE is not set
CONFIG_EFI_VARIABLE_NO_STORE=y
